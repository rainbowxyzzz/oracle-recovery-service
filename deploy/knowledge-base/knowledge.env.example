# Knowledge base API feature gate and controlled Markdown/Obsidian Vault mount.
KNOWLEDGE_ENABLED=false
KNOWLEDGE_VAULT_ROOT=/data/knowledge-vault
KNOWLEDGE_MAX_FILES=5000
KNOWLEDGE_MAX_FILE_BYTES=1048576
KNOWLEDGE_CHUNK_CHARS=3000
KNOWLEDGE_CHUNK_OVERLAP_CHARS=300

# Qdrant REST API. Keep API keys in the real .env only.
KNOWLEDGE_QDRANT_URL=http://knowledge-qdrant:6333
KNOWLEDGE_QDRANT_API_KEY=
KNOWLEDGE_QDRANT_COLLECTION=oracle_recovery_knowledge

# OpenAI-compatible BGE-M3 embeddings endpoint.
KNOWLEDGE_EMBEDDING_BASE_URL=http://knowledge-embedding:8001/v1
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_MODEL=bge-m3
KNOWLEDGE_SCORE_THRESHOLD=0.25

# OpenAI-compatible answer model endpoint. This may point to local Qwen/vLLM or an approved API.
KNOWLEDGE_CHAT_BASE_URL=http://knowledge-llm:8000/v1
KNOWLEDGE_CHAT_API_KEY=
KNOWLEDGE_CHAT_MODEL=Qwen3-32B
KNOWLEDGE_REQUEST_TIMEOUT_SECONDS=60
