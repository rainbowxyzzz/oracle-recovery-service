# Oracle 21c Enterprise Edition container
ORACLE21C_MODE=auto
ORACLE21C_IMAGE=softwareplant/oracle:clean-21.3.0-ee
# Optional image archive path. The application package does not include the Oracle business image.
ORACLE21C_IMAGE_TAR=
ORACLE21C_CONTAINER=oracle-recovery-oracle21c-ee
ORACLE21C_HOSTNAME=oracle21c-ee
ORACLE21C_NETWORK=oracle-recovery-net

# Host ports
ORACLE21C_LISTENER_PORT=1522
ORACLE21C_EM_PORT=5501

# Database
ORACLE21C_SID=ORCL21C
ORACLE21C_PDB=ORCLPDB1
ORACLE21C_PASSWORD=ChangeMe_Oracle21cEE_123
ORACLE21C_CHARACTERSET=ZHS16GBK
ORACLE21C_ENABLE_ARCHIVELOG=false

# All persistent Oracle data is stored below this host path.
ORACLE21C_DATA_ROOT=/data/oracle-recovery/oracle21c
ORACLE21C_ORADATA_HOST_PATH=/data/oracle-recovery/oracle21c/oradata
ORACLE21C_DMP_HOST_PATH=/data/oracle-recovery/oracle21c/dmp
ORACLE21C_TABLESPACE_HOST_PATH=/data/oracle-recovery/oracle21c/tablespaces

# Runtime
ORACLE21C_MEMORY_LIMIT=
ORACLE21C_SHM_SIZE=1g
ORACLE21C_STARTUP_TIMEOUT_SECONDS=1800

# Optional DBCA sizing for a newly created database. Values are in MB where applicable.
ORACLE21C_INIT_SGA_SIZE=
ORACLE21C_INIT_PGA_SIZE=
ORACLE21C_INIT_CPU_COUNT=
ORACLE21C_INIT_PROCESSES=

# TEMP tablespace sizing for large impdp index/constraint phases.
ORACLE21C_TEMP_AUTO_EXTEND=true
ORACLE21C_TEMPFILE_NAME=temp_recovery_01.dbf
ORACLE21C_TEMPFILE_INITIAL_SIZE=20G
ORACLE21C_TEMPFILE_NEXT_SIZE=2G
ORACLE21C_TEMPFILE_MAX_SIZE=100G

# AL32UTF8 recovery target. It reuses the same image and DMP input directory,
# but keeps database files and imported tablespaces isolated from the primary target.
UTF_ORACLE21C_MODE=auto
UTF_ORACLE21C_CONTAINER=oracle-recovery-oracle21c-utf8
UTF_ORACLE21C_HOSTNAME=oracle21c-utf8
UTF_ORACLE21C_LISTENER_PORT=1523
UTF_ORACLE21C_EM_PORT=5502
UTF_ORACLE21C_SID=ORCLUTF8
UTF_ORACLE21C_PDB=ORCLPDBUTF8
UTF_ORACLE21C_CHARACTERSET=AL32UTF8
UTF_ORACLE21C_DATA_ROOT=/data/oracle-recovery/oracle21c-utf8
UTF_ORACLE21C_ORADATA_HOST_PATH=/data/oracle-recovery/oracle21c-utf8/oradata
UTF_ORACLE21C_DMP_HOST_PATH=/data/oracle-recovery/oracle21c/dmp
UTF_ORACLE21C_TABLESPACE_HOST_PATH=/data/oracle-recovery/oracle21c-utf8/tablespaces
