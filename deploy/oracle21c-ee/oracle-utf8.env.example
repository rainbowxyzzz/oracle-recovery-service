# Dedicated configuration; the business package .env is NOT read.
# Required: set a database password, not the SSH password. Use shell single quotes.
ORACLE21C_PASSWORD=''

# Existing local Oracle 21c image; optional offline archive (absolute or relative to this file).
ORACLE21C_IMAGE=softwareplant/oracle:clean-21.3.0-ee
ORACLE21C_IMAGE_TAR=
ORACLE21C_CONTAINER=oracle-recovery-oracle21c-utf8
ORACLE21C_HOSTNAME=oracle21c-utf8
ORACLE21C_NETWORK=oracle-recovery-net
ORACLE21C_LISTENER_PORT=1523
ORACLE21C_EM_PORT=5502
ORACLE21C_SID=ORCLUTF8
ORACLE21C_PDB=ORCLPDBUTF8
ORACLE21C_CHARACTERSET=AL32UTF8
ORACLE21C_NCHAR_CHARACTERSET=AL16UTF16
ORACLE21C_ENABLE_ARCHIVELOG=false
ORACLE21C_ORACLE_HOME=/opt/oracle/product/21c/dbhome_1

# Data and tablespace directories must be empty for a new container. DMP may be shared.
ORACLE21C_DATA_ROOT=/data/oracle-recovery/oracle21c-utf8
ORACLE21C_ORADATA_HOST_PATH=/data/oracle-recovery/oracle21c-utf8/oradata
ORACLE21C_TABLESPACE_HOST_PATH=/data/oracle-recovery/oracle21c-utf8/tablespaces
ORACLE21C_DMP_HOST_PATH=/data/oracle-recovery/oracle21c/dmp

# MB; 8192 exceeds the 5744M minimum reported on the affected server.
# Initial DBCA settings apply ONLY when creating a database; not to an existing SPFILE.
# Startup preflight requires SGA + PGA + 2048MB available host memory (default 12288MB).
ORACLE21C_INIT_SGA_SIZE=8192
ORACLE21C_INIT_PGA_SIZE=2048
ORACLE21C_INIT_CPU_COUNT=
ORACLE21C_INIT_PROCESSES=
ORACLE21C_MEMORY_LIMIT=20g
ORACLE21C_SHM_SIZE=1g
ORACLE21C_STARTUP_TIMEOUT_SECONDS=1800
ORACLE21C_TEMP_AUTO_EXTEND=true
ORACLE21C_TEMPFILE_NAME=temp_recovery_utf8_01.dbf
ORACLE21C_TEMPFILE_INITIAL_SIZE=20G
ORACLE21C_TEMPFILE_NEXT_SIZE=2G
ORACLE21C_TEMPFILE_MAX_SIZE=100G
