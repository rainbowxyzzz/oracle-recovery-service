# Keep deployable text files Linux-compatible across Windows checkouts.
*.sh text eol=lf
*.env.example text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Preserve Windows-native launchers.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never normalize binary artifacts accidentally added later.
*.png binary
*.gif binary
*.ico binary
*.jar binary

